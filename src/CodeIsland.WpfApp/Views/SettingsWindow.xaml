<Window x:Class="CodeIsland.WpfApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CodeIsland.WpfApp.Views"
        Title="CodeIsland 设置"
        Width="760"
        Height="620"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF050507"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border Background="#FF050507" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="CodeIsland 设置"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource HudTextBrush}"
                 Margin="0,0,0,12" />

      <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12" Padding="12,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HudAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding FeedbackText}" FontSize="12" Foreground="#D9FFFFFF" TextWrapping="Wrap" Margin="10,0,0,0" />
        </Grid>
      </Border>

      <!-- Runtime 状态栏 -->
      <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12" Padding="10,8">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="10" Height="10" Fill="{Binding RuntimeStatusColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RuntimeConnectionStatus}" FontSize="12" Foreground="#D9FFFFFF" Margin="10,0,0,0" />
        </StackPanel>
      </Border>

      <TabControl x:Name="SettingsTabs" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource HudTextBrush}" SelectionChanged="SettingsTabs_SelectionChanged">
        <TabItem Header="通用">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="通用设置" Style="{StaticResource SettingsSectionTitleStyle}" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="开机自启" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="开机后自动启动 CodeIsland。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="显示位置" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="选择悬浮窗在屏幕上的位置。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding DisplayPosition, Mode=TwoWay}" SelectedValuePath="Tag" VerticalAlignment="Center" MinHeight="34">
                    <ComboBoxItem Content="顶部居中" Tag="top-center" />
                    <ComboBoxItem Content="左侧居中" Tag="middle-left" />
                    <ComboBoxItem Content="右侧居中" Tag="middle-right" />
                    <ComboBoxItem Content="底部居中" Tag="bottom-center" />
                  </ComboBox>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="显示器" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="选择悬浮窗显示在哪个屏幕。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding DisplayMonitorOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValue="{Binding DisplayMonitor, Mode=TwoWay}"
                            SelectedValuePath="Id"
                            VerticalAlignment="Center"
                            MinHeight="34" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="行为">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="行为与通知" Style="{StaticResource SettingsSectionTitleStyle}" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="自动审批安全工具" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="自动允许只读查看操作，其他操作仍需确认。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding AutoApproveSafeTools, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="提醒转发地址" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="填写网址后，重要提醒会发送到这里。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding WebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="会话超时（秒）" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="超过这个时间未操作，会自动结束等待。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding SessionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="全屏时隐藏" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="全屏使用其他应用时隐藏悬浮窗。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding HideWhenFullscreen, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="外观">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="HUD 外观" Style="{StaticResource SettingsSectionTitleStyle}" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="HUD 样式" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="经典保留当前尺寸，紧凑会使用更小折叠态并只在待办时显示提醒灯效。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding HudDensityMode, Mode=TwoWay}" SelectedValuePath="Tag" VerticalAlignment="Center" MinHeight="34">
                    <ComboBoxItem Content="经典" Tag="classic" />
                    <ComboBoxItem Content="紧凑" Tag="compact" />
                  </ComboBox>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="面板高度模式" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="自动会随内容调整，固定会保持高度不变，紧凑会占更少空间。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding PanelHeightMode, Mode=TwoWay}" SelectedValuePath="Tag" VerticalAlignment="Center" MinHeight="34">
                    <ComboBoxItem Content="自动" Tag="auto" />
                    <ComboBoxItem Content="固定" Tag="fixed" />
                    <ComboBoxItem Content="紧凑" Tag="compact" />
                  </ComboBox>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="完整显示最近消息" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="开启后，最近对话会显示完整文本。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding ShowFullRecentMessages, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="音效">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="运行时音效" Style="{StaticResource SettingsSectionTitleStyle}" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="启用音效" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="审批、完成等提醒会播放音效。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding SoundEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="音量" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="调整提醒音效的音量。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="智能抑制重复音效" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="短时间内相同音效只播放一次。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding SmartSoundSuppression, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="快捷键">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="全局快捷键" Style="{StaticResource SettingsSectionTitleStyle}" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="切换悬浮窗" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="显示、展开或收起悬浮窗。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding TogglePanelHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="批准当前审批" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="触发当前权限卡片的“允许一次”。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding ApproveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="拒绝当前审批" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="触发当前权限卡片的“拒绝”。" Style="{StaticResource SettingsHelpStyle}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding DenyHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                </Grid>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="工具连接">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <TextBlock Text="工具连接" Style="{StaticResource SettingsSectionTitleStyle}" />

              <!-- 工具列表 -->
              <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource SettingsCardStyle}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 图标 -->
                        <ContentControl Grid.Column="0" Content="{StaticResource {Binding IconResourceKey}}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <!-- 名称和描述 -->
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SettingsLabelStyle}" />
                          <TextBlock Text="让 CodeIsland 接收该工具的状态。" Style="{StaticResource SettingsHelpStyle}" />
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <Button Grid.Column="2"
                                Content="{Binding ButtonContent}"
                                IsEnabled="{Binding ButtonEnabled}"
                                Tag="{Binding}"
                                Click="SourceToggle_Click"
                                Padding="16,7"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="关于">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
            <StackPanel>
              <!-- 现有关于内容 -->
              <views:AboutView />

              <!-- Runtime 信息 -->
              <TextBlock Text="Runtime 信息" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,20,0,12" />

              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="{Binding RuntimeProduct}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                  <TextBlock Margin="0,4,0,0">
                    <Run Text="当前版本: " Foreground="#99FFFFFF" />
                    <Run Text="{Binding CurrentVersion}" Foreground="{StaticResource HudTextBrush}" FontWeight="Medium" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0">
                    <Run Text="最新版本: " Foreground="#99FFFFFF" />
                    <Run Text="{Binding LatestVersion}" Foreground="{StaticResource HudTextBrush}" FontWeight="Medium" />
                  </TextBlock>
                  <TextBlock Text="{Binding UpdateCheckStatus}" FontSize="12" Foreground="#D9FFFFFF" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
