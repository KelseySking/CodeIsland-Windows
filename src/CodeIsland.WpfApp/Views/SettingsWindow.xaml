<Window x:Class="CodeIsland.WpfApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:CodeIsland.WpfApp.Services"
        xmlns:views="clr-namespace:CodeIsland.WpfApp.Views"
        Title="CodeIsland 设置"
        Width="840"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootChrome"
          Background="#FF050507"
          BorderBrush="#33000000"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True"
          SizeChanged="RootChrome_SizeChanged">
    <Border.Clip>
      <RectangleGeometry x:Name="RootClip" RadiusX="14" RadiusY="14" />
    </Border.Clip>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 顶栏圆角与根一致，避免上圆下尖 -->
      <Border Grid.Row="0"
              Height="48"
              Background="#FF08080C"
              CornerRadius="14,14,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HudAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="CodeIsland 设置"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HudTextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1"
                  Style="{StaticResource SettingsCardStyle}"
                  Margin="0,0,8,0"
                  Padding="10,6"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding RuntimeStatusColor}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RuntimeConnectionStatus}" FontSize="11" Foreground="#D9FFFFFF" Margin="8,0,0,0" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button Content="─"
                    Style="{StaticResource SettingsTitleBarButtonStyle}"
                    Click="Minimize_Click"
                    ToolTip="最小化" />
            <Button Content="✕"
                    Style="{StaticResource SettingsCloseButtonStyle}"
                    Click="Close_Click"
                    ToolTip="关闭" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Margin="16,12,16,0" Padding="12,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HudAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding FeedbackText}" FontSize="12" Foreground="#D9FFFFFF" TextWrapping="Wrap" Margin="10,0,0,0" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="16,12,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FF0B0B10"
                BorderBrush="#18000000"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
          <ListBox x:Name="SectionNav"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectedIndex="0"
                   SelectionChanged="SectionNav_SelectionChanged"
                   ItemContainerStyle="{StaticResource SettingsNavItemStyle}">
            <ListBoxItem Tag="general" Content="通用" />
            <ListBoxItem Tag="behavior" Content="行为" />
            <ListBoxItem Tag="appearance" Content="外观" />
            <ListBoxItem Tag="hotkeys" Content="快捷键" />
            <ListBoxItem Tag="tools" Content="工具连接" />
            <ListBoxItem Tag="pets" Content="宠物" />
            <ListBoxItem Tag="codeorbit" Content="CodeOrbit" />
            <ListBoxItem Tag="about" Content="关于" />
          </ListBox>
        </Border>

        <Border Grid.Column="2"
                Background="#FF0B0B10"
                BorderBrush="#18000000"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                ClipToBounds="True">
          <Grid x:Name="ContentHost" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="ContentHostTranslate" />
            </Grid.RenderTransform>

            <!-- 通用 -->
            <ScrollViewer x:Name="SectionGeneral"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="通用设置" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="开机自启" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="登录 Windows 后自动启动。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="显示位置" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="悬浮窗贴在屏幕的哪一边。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding DisplayPosition, Mode=TwoWay}" SelectedValuePath="Tag" VerticalAlignment="Center" MinHeight="34">
                      <ComboBoxItem Content="顶部居中" Tag="top-center" />
                      <ComboBoxItem Content="左侧居中" Tag="middle-left" />
                      <ComboBoxItem Content="右侧居中" Tag="middle-right" />
                      <ComboBoxItem Content="底部居中" Tag="bottom-center" />
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="显示器" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="多显示器时显示在哪块屏。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DisplayMonitorOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValue="{Binding DisplayMonitor, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              VerticalAlignment="Center"
                              MinHeight="34" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 行为 -->
            <ScrollViewer x:Name="SectionBehavior"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="行为与通知" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="自动审批安全工具" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="只读操作自动通过，其余仍需确认。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding AutoApproveSafeTools, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsWarningCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="一键通过审批（问答除外）" Style="{StaticResource SettingsLabelStyle}" Foreground="#FFFFB4AF" />
                      <TextBlock Text="自动通过全部权限（问答仍需确认）。风险较高，请谨慎。" Style="{StaticResource SettingsHelpStyle}" Foreground="#CCFFB4AF" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding AutoApproveAllPermissions, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="提醒转发地址" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="重要提醒会 POST 到该地址。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding WebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="会话超时（秒）" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="超时未操作则自动结束等待。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding SessionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="全屏时隐藏" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="其他应用全屏时自动隐藏。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding HideWhenFullscreen, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 外观（含音效） -->
            <ScrollViewer x:Name="SectionAppearance"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="HUD 外观" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="HUD 样式" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="经典/紧凑为信息条；悬浮球与宠物可拖拽。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <ComboBox SelectedValue="{Binding HudDensityMode, Mode=TwoWay}" SelectedValuePath="Tag" MinHeight="34">
                        <ComboBoxItem Content="经典" Tag="classic" />
                        <ComboBoxItem Content="紧凑" Tag="compact" />
                        <ComboBoxItem Content="悬浮球" Tag="orb" />
                        <ComboBoxItem Content="宠物" Tag="pet" IsEnabled="{Binding HasDefaultPet}" />
                      </ComboBox>
                      <TextBlock Text="请先到宠物栏目导入并选择默认宠物。"
                                 Style="{StaticResource SettingsHelpStyle}"
                                 Foreground="#FFFFB86B"
                                 Margin="0,6,0,0"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding HasNoDefaultPet, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                      <Button Content="重置浮动模式位置"
                              Margin="0,8,0,0"
                              MinHeight="30"
                              Padding="10,4"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding IsFloatingHudDensityMode}"
                              Click="OnResetOrbPositionClick" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="面板高度模式" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="自动随内容变化；固定保持高度；紧凑更省空间。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding PanelHeightMode, Mode=TwoWay}" SelectedValuePath="Tag" VerticalAlignment="Center" MinHeight="34">
                      <ComboBoxItem Content="自动" Tag="auto" />
                      <ComboBoxItem Content="固定" Tag="fixed" />
                      <ComboBoxItem Content="紧凑" Tag="compact" />
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="完整显示最近消息" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="展开最近对话的完整文本。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding ShowFullRecentMessages, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <TextBlock Text="运行时音效" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,8,0,10" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="启用音效" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="审批、完成等事件播放提示音。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding SoundEnabled, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="音量" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="提示音音量。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="智能抑制重复音效" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="短时间内相同提示音只响一次。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding SmartSoundSuppression, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 快捷键 -->
            <ScrollViewer x:Name="SectionHotkeys"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewKeyDown="HotkeySection_PreviewKeyDown">
              <StackPanel>
                <TextBlock Text="全局快捷键" Style="{StaticResource SettingsSectionTitleStyle}" />
                <TextBlock Text="点击「点击录制」，再按下组合键。Esc 取消录制。"
                           Style="{StaticResource SettingsHelpStyle}"
                           Margin="0,0,0,12" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="切换悬浮窗" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="显示或收起悬浮窗。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TogglePanelHotkey}"
                               FontSize="13"
                               Foreground="{StaticResource HudTextBrush}"
                               VerticalAlignment="Center"
                               MinWidth="120"
                               Margin="12,0" />
                    <Button Grid.Column="2"
                            Content="{Binding ToggleHotkeyRecordLabel}"
                            Click="RecordToggleHotkey_Click"
                            MinWidth="96"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="批准当前审批" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="批准当前待处理权限。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ApproveHotkey}"
                               FontSize="13"
                               Foreground="{StaticResource HudTextBrush}"
                               VerticalAlignment="Center"
                               MinWidth="120"
                               Margin="12,0" />
                    <Button Grid.Column="2"
                            Content="{Binding ApproveHotkeyRecordLabel}"
                            Click="RecordApproveHotkey_Click"
                            MinWidth="96"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="拒绝当前审批" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="拒绝当前待处理权限。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DenyHotkey}"
                               FontSize="13"
                               Foreground="{StaticResource HudTextBrush}"
                               VerticalAlignment="Center"
                               MinWidth="120"
                               Margin="12,0" />
                    <Button Grid.Column="2"
                            Content="{Binding DenyHotkeyRecordLabel}"
                            Click="RecordDenyHotkey_Click"
                            MinWidth="96"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 工具连接 -->
            <ScrollViewer x:Name="SectionTools"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="工具连接" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="WSL 发行版" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="在所选发行版连接工具，与 Windows 侧独立。首次使用时检测 WSL。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding WslDistros}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Name"
                              SelectedValue="{Binding SelectedWslDistro, Mode=TwoWay}"
                              DropDownOpened="WslDistroComboBox_DropDownOpened" />
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Sources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0"
                                  Width="32"
                                  Height="32"
                                  CornerRadius="8"
                                  Background="#0FFFFFFF"
                                  BorderBrush="#18FFFFFF"
                                  BorderThickness="1"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0">
                            <Grid>
                              <TextBlock Text="{Binding IconFallbackText}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="#BFFFFFFF"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasSourceIcon, Converter={x:Static views:InverseBoolVisibilityConverter.Instance}}" />
                              <Image Source="{Binding SourceIconUri}"
                                     Width="22"
                                     Height="22"
                                     Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding HasSourceIcon, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBlock Text="连接后接收该工具状态。" Style="{StaticResource SettingsHelpStyle}" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding ButtonContent}"
                                    Style="{StaticResource SourceConnectButtonStyle}"
                                    IsEnabled="{Binding ButtonEnabled}"
                                    Tag="{Binding}"
                                    Click="SourceToggle_Click"
                                    Padding="16,7"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <Button Content="{Binding WslButtonContent}"
                                    Style="{StaticResource SourceWslConnectButtonStyle}"
                                    IsEnabled="{Binding WslButtonEnabled}"
                                    Tag="{Binding}"
                                    Click="WslSourceToggle_Click"
                                    Padding="12,7"
                                    VerticalAlignment="Center"
                                    ToolTip="在 WSL 中连接/断开（与 Windows 侧独立）" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- 宠物 -->
            <ScrollViewer x:Name="SectionPets"
                          Visibility="Collapsed"
                          AllowDrop="True"
                          PreviewDragOver="PetSection_PreviewDragOver"
                          PreviewDrop="PetSection_PreviewDrop"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="宠物" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="导入 Codex V1 / V2 宠物" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="{Binding PetImportFeedback}" Style="{StaticResource SettingsHelpStyle}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DefaultPetName, StringFormat=当前默认：{0}}"
                                 FontSize="12"
                                 Foreground="{StaticResource HudAccentBrush}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="选择目录"
                              Click="ImportPet_Click"
                              IsEnabled="{Binding PetActionsEnabled}"
                              Padding="14,7"
                              Margin="0,0,8,0" />
                      <Button Content="选择压缩包"
                              Click="ImportPetArchive_Click"
                              IsEnabled="{Binding PetActionsEnabled}"
                              Padding="14,7"
                              Margin="0,0,8,0" />
                      <Button Content="扫描 Codex"
                              Click="ImportCodexPets_Click"
                              IsEnabled="{Binding PetActionsEnabled}"
                              Padding="14,7" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="宠物大小" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="全局调整宠物显示尺寸，重启后保留。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <Slider Minimum="{x:Static services:WpfHudDensityMode.PetScalePercentMinimum}"
                              Maximum="{x:Static services:WpfHudDensityMode.PetScalePercentMaximum}"
                              TickFrequency="{x:Static services:WpfHudDensityMode.PetScalePercentStep}"
                              SmallChange="{x:Static services:WpfHudDensityMode.PetScalePercentStep}"
                              LargeChange="{x:Static services:WpfHudDensityMode.PetScalePercentStep}"
                              IsSnapToTickEnabled="True"
                              Value="{Binding PetScalePercent, Mode=TwoWay}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PetScalePercent, StringFormat={}{0:0}%}"
                                 Foreground="{StaticResource HudAccentBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}"
                        Visibility="{Binding HasNoDefaultPet, Converter={x:Static views:BoolVisibilityConverter.Instance}}">
                  <TextBlock Text="尚未导入有效宠物。导入成功后即可在“外观”中选择宠物模式。"
                             Style="{StaticResource SettingsHelpStyle}"
                             TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Pets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SettingsLabelStyle}" />
                              <TextBlock Text="默认"
                                         Margin="8,0,0,0"
                                         Padding="6,1"
                                         FontSize="11"
                                         Foreground="#FF08110E"
                                         Background="{StaticResource HudAccentBrush}"
                                         Visibility="{Binding IsDefault, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsHelpStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Id, StringFormat=ID：{0}}" FontSize="11" Foreground="#66FFFFFF" Margin="0,4,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="设为默认"
                                    Tag="{Binding}"
                                    Click="SetDefaultPet_Click"
                                    Visibility="{Binding IsDefault, Converter={x:Static views:InverseBoolVisibilityConverter.Instance}}"
                                    Padding="12,6"
                                    Margin="0,0,8,0" />
                            <Button Content="删除"
                                    Tag="{Binding}"
                                    Click="DeletePet_Click"
                                    Padding="12,6"
                                    Foreground="#FFFFB4AF" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- CodeOrbit -->
            <ScrollViewer x:Name="SectionCodeOrbit"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="CodeOrbit 连接" Style="{StaticResource SettingsSectionTitleStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{Binding RuntimeStatusColor}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding RuntimeConnectionStatus}" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="{Binding CodeOrbitStatusHelp}" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="由本程序启动 CodeOrbit" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="开启后自动启动本地 CodeOrbit；关闭则只连接已有实例。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource SettingsToggleStyle}"
                              IsChecked="{Binding ManagedLaunchEnabled, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="绑定地址" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="默认 127.0.0.1。填 0.0.0.0 可对外共享（见下方警告）。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding ApiBindHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border x:Name="WildcardHostWarningCard"
                        Style="{StaticResource SettingsWarningCardStyle}"
                        Visibility="{Binding ShowWildcardHostWarning, Converter={x:Static views:BoolVisibilityConverter.Instance}}">
                  <StackPanel>
                    <TextBlock Text="共享绑定警告" Style="{StaticResource SettingsLabelStyle}" Foreground="#FFFFB4AF" />
                    <TextBlock Text="通配地址会对外共享监听；本机仍走 127.0.0.1。退出应用不会强制关闭该实例。" Style="{StaticResource SettingsHelpStyle}" Foreground="#CCFFB4AF" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="端口" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="范围 1024–65535，默认 32145。" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding ApiPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel>
                    <TextBlock Text="API Token" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="连接鉴权用，请勿公开分享。" Style="{StaticResource SettingsHelpStyle}" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="ApiTokenTextBox"
                               Text="{Binding ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               MinHeight="34"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Visibility="{Binding ShowApiToken, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                      <PasswordBox x:Name="ApiTokenPasswordBox"
                                   MinHeight="34"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   PasswordChanged="ApiTokenPasswordBox_PasswordChanged"
                                   Visibility="{Binding ShowApiToken, Converter={x:Static views:InverseBoolVisibilityConverter.Instance}}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding TokenVisibilityLabel}"
                                Click="ToggleTokenVisibility_Click"
                                MinWidth="72"
                                Margin="0,0,6,0" />
                        <Button Content="复制"
                                Click="CopyApiToken_Click"
                                MinWidth="64"
                                Margin="0,0,6,0" />
                        <Button Content="重新生成"
                                Click="RegenerateApiToken_Click"
                                MinWidth="80" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="应用并重连" Style="{StaticResource SettingsLabelStyle}" />
                      <TextBlock Text="{Binding CodeOrbitReconnectFeedback}" Style="{StaticResource SettingsHelpStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding CodeOrbitReconnectButtonLabel}"
                            Click="ApplyAndReconnectCodeOrbit_Click"
                            IsEnabled="{Binding CodeOrbitReconnectEnabled}"
                            MinWidth="120"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Background="#228EE6D0"
                            BorderBrush="#668EE6D0" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 关于 -->
            <ScrollViewer x:Name="SectionAbout"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <views:AboutView />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
