<UserControl x:Class="CodeIsland.WpfApp.Views.HudDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views">
  <Grid MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="返回" Command="{Binding ShowSessionListCommand}" FontSize="11" Background="#12FFFFFF" Foreground="#D9FFFFFF" BorderBrush="#22000000" Padding="10,5" />
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <TextBlock Text="{Binding DetailTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding DetailSubtitle}" FontSize="10" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Border Grid.Column="2" Background="#10101010" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
        <TextBlock Text="详情" FontSize="10" Foreground="#D9FFFFFF" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" Visibility="{Binding IsSelectedSessionDetail, Converter={x:Static views:BoolVisibilityConverter.Instance}}" ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.8*" MinHeight="72" />
        <RowDefinition Height="1.2*" MinHeight="92" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#08000000" CornerRadius="10" Padding="10,7" BorderBrush="#22000000" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="状态" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding DetailStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="当前工具" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding DetailToolText}" FontSize="12" Foreground="#D9FFFFFF" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="最近消息" FontSize="10" Foreground="#80FFFFFF" />
          <TextBlock Grid.Row="1" Text="用户问题" FontSize="10" Foreground="#80FFFFFF" Margin="0,8,0,0" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0" ClipToBounds="True">
            <TextBlock Text="{Binding DetailUserPrompt}" FontSize="12" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding DetailAssistantReplyTitle}" FontSize="10" Foreground="#80FFFFFF" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0" ClipToBounds="True">
            <TextBlock Text="{Binding DetailAssistantReply}" FontSize="12" Foreground="#F2FFFFFF" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding}" Visibility="{Binding IsSelectedPermissionDetail, Converter={x:Static views:BoolVisibilityConverter.Instance}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <views:ApprovalCardView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl Grid.Row="1" Content="{Binding}" Visibility="{Binding IsSelectedQuestionDetail, Converter={x:Static views:BoolVisibilityConverter.Instance}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <views:QuestionCardView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding IsSelectedSessionDetail, Converter={x:Static views:BoolVisibilityConverter.Instance}}">
      <Button Content="跳转终端" Command="{Binding SelectedSessionJumpToTerminalCommand}" FontSize="11" Background="#18FFFFFF" Foreground="#F2FFFFFF" BorderBrush="#22000000" Padding="14,7" Margin="0,0,8,0" />
      <Button Content="收起" Command="{Binding CollapseCommand}" FontSize="11" Background="#12FFFFFF" Foreground="#D9FFFFFF" BorderBrush="#22000000" Padding="14,7" />
    </StackPanel>
  </Grid>
</UserControl>
