<UserControl x:Class="CodeIsland.WpfApp.Views.CompletionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views">
  <Border MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}" Background="{StaticResource HudCardBrush}" CornerRadius="14" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.85*" MinHeight="0" />
        <RowDefinition Height="1.15*" MinHeight="84" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14" Background="#267CFF9B" BorderBrush="#407CFF9B" BorderThickness="1">
          <TextBlock Text="✓" FontSize="15" FontWeight="Bold" Foreground="#E8FFE8" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock Text="回复完成" FontSize="14" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
          <TextBlock Text="AI 已结束本轮回复" FontSize="10" Foreground="#80FFFFFF" />
        </StackPanel>
        <Border Grid.Column="2" Background="#1A7CFF9B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="完成" FontSize="10" FontWeight="SemiBold" Foreground="#9BE27D" />
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#08000000" CornerRadius="10" Padding="10,7" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="命令行工具" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding CompletionSource}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="项目" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding CompletionProject}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" Visibility="{Binding HasCompletionUserPrompt, Converter={x:Static views:BoolVisibilityConverter.Instance}}" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="你的提问" FontSize="10" Foreground="#80FFFFFF" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" ClipToBounds="True">
            <TextBlock Text="{Binding CompletionUserPrompt}" FontSize="12" Foreground="#F2FFFFFF" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="AI 回复" FontSize="10" Foreground="#80FFFFFF" />
          <views:MarkdownViewer Grid.Row="1"
                                Markdown="{Binding CompletionText}"
                                BodyFontSize="12"
                                Margin="0,6,0,0"
                                ClipToBounds="True" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="完成" Command="{Binding DismissCompletionCommand}" FontSize="11" FontWeight="SemiBold" Background="#337CFF9B" Foreground="#E8FFE8" BorderBrush="#667CFF9B" Padding="16,7" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
