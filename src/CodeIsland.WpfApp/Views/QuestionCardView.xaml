<UserControl x:Class="CodeIsland.WpfApp.Views.QuestionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views">
  <Border MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}" Background="{StaticResource HudCardBrush}" CornerRadius="14" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.9*" MinHeight="78" />
        <RowDefinition Height="1.1*" MinHeight="62" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14" Background="#267AB8FF" BorderBrush="#407AB8FF" BorderThickness="1">
          <TextBlock Text="?" FontSize="15" FontWeight="Bold" Foreground="#DCEBFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock Text="问题" FontSize="14" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
          <TextBlock Text="AI 工具正在等待你的输入" FontSize="10" Foreground="#80FFFFFF" />
        </StackPanel>
        <Border Grid.Column="2" Background="#1A7AB8FF" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="等待回答" FontSize="10" FontWeight="SemiBold" Foreground="#DCEBFF" />
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#08000000" CornerRadius="10" Padding="10,7" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="命令行工具" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding QuestionSource}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="项目" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding QuestionProject}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding QuestionHeader}" FontSize="11" FontWeight="SemiBold" Foreground="#BFDCEBFF" TextTrimming="CharacterEllipsis" Visibility="{Binding HasQuestionHeader, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
            <TextBlock Grid.Column="1" Text="{Binding QuestionProgressText}" FontSize="10" Foreground="#80FFFFFF" Visibility="{Binding HasQuestionProgress, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0" ClipToBounds="True">
            <TextBlock Text="{Binding QuestionText}" FontSize="12" Foreground="#F2FFFFFF" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,10,0,0" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSingleSelectOptions, Converter={x:Static views:BoolVisibilityConverter.Instance}}" ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding QuestionOptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SelectQuestionOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#127AB8FF" Foreground="#E6F1FF" BorderBrush="#337AB8FF" BorderThickness="1" Padding="12,7" Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#A6FFFFFF" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasMultiSelectOptions, Converter={x:Static views:BoolVisibilityConverter.Instance}}" ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding QuestionOptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="#E6F1FF" Margin="0,2" Padding="8,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#A6FFFFFF" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBox Text="{Binding QuestionAnswer, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="#FFFFFF" Background="#0DFFFFFF" BorderBrush="#22000000" BorderThickness="1" Padding="10,7" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" Visibility="{Binding ShouldShowAnswerTextBox, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
      </Grid>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="忽略" Command="{Binding DismissQuestionCommand}" FontSize="11" Background="#12FFFFFF" Foreground="#D9FFFFFF" BorderBrush="#22000000" Padding="14,7" Margin="0,0,7,0" />
        <Button Content="提交" Command="{Binding SubmitQuestionCommand}" FontSize="11" FontWeight="SemiBold" Background="#337CFF9B" Foreground="#E8FFE8" BorderBrush="#667CFF9B" Padding="16,7" Visibility="{Binding ShouldShowQuestionSubmitButton, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
