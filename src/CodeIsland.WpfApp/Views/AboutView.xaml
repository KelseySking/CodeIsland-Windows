<UserControl x:Class="CodeIsland.WpfApp.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" Margin="4" MaxWidth="560">
      <StackPanel HorizontalAlignment="Center" Margin="0,4,0,18">
        <Border Width="76" Height="76" CornerRadius="20" Background="#0DFFFFFF" BorderBrush="#22000000" BorderThickness="1" Margin="0,0,0,12">
          <views:PixelMascotControl Width="58" Height="62" PixelSize="4.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="CodeIsland for Windows" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource HudMutedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
        <TextBlock Text="Windows 桌面 HUD，用于实时展示 AI 编程代理会话状态、权限审批和问答交互。WPF 迁移版专注于更顺滑的浮窗展开、收起与缩放动画。"
                   FontSize="12" Foreground="#CCFFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
      </Border>

      <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
        <StackPanel>
          <TextBlock Text="更新检查" Style="{StaticResource SettingsLabelStyle}" />
          <TextBlock Text="点击后会通过 GitHub Releases API 检查最新版本，并显示下载入口或错误原因。" Style="{StaticResource SettingsHelpStyle}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="#D9FFFFFF" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ReleaseNotesPreview}" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasReleaseNotes, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="检查更新" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding CanCheckUpdate}" Padding="14,7" Margin="12,0,0,0" VerticalAlignment="Top" />
          </Grid>
          <Button Content="打开下载页面" Command="{Binding OpenDownloadCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding HasDownloadUrl, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
        <StackPanel>
          <TextBlock Text="项目链接" Style="{StaticResource SettingsLabelStyle}" />
          <Button Content="GitHub：KelseySking/CodeIsland-Windows" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="许可证" FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Center" />
          <TextBlock Text="MIT 许可证" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock Text="© 2024-2026 CodeIsland-Windows Contributors" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
