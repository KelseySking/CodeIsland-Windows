<UserControl x:Class="CodeIsland.WpfApp.Views.ApprovalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}" Background="{StaticResource HudCardBrush}" CornerRadius="14" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14" Background="#26FFB86B" BorderBrush="#40FFB86B" BorderThickness="1">
          <TextBlock Text="!" FontSize="15" FontWeight="Bold" Foreground="#FFFFD0" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock Text="权限审批" FontSize="14" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
          <TextBlock Text="AI 工具请求执行受保护操作" FontSize="10" Foreground="#80FFFFFF" />
        </StackPanel>
        <Border Grid.Column="2" Background="#1AFFB86B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="等待处理" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFD0" />
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#08000000" CornerRadius="10" Padding="10,7" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="命令行工具" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding PermissionSource}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="项目" FontSize="10" Foreground="#80FFFFFF" />
            <TextBlock Text="{Binding PermissionProject}" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#0DFFFFFF" CornerRadius="12" Padding="12,9" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="请求内容" FontSize="10" Foreground="#80FFFFFF" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" ClipToBounds="True">
            <TextBlock Text="{Binding PermissionCommand}" FontSize="12" Foreground="#F2FFFFFF" FontFamily="Consolas" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="#08000000" CornerRadius="8" Padding="9,5" BorderBrush="#22000000" BorderThickness="1" Margin="0,10,0,0">
        <TextBlock Text="{Binding PermissionWorkDir, StringFormat=路径: {0}}" FontSize="10" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding PermissionWorkDir}" />
      </Border>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="拒绝" Command="{Binding DenyCommand}" FontSize="11" FontWeight="SemiBold" Background="#40FF5F57" Foreground="#FFD8D6" BorderBrush="#66FF5F57" Padding="14,7" Margin="0,0,7,0" />
        <Button Content="忽略" Command="{Binding DismissPermissionCommand}" FontSize="11" Background="#12FFFFFF" Foreground="#D9FFFFFF" BorderBrush="#22000000" Padding="14,7" Margin="0,0,7,0" />
        <Button Content="允许一次" Command="{Binding ApproveCommand}" FontSize="11" Background="#12FFFFFF" Foreground="#D9FFFFFF" BorderBrush="#22000000" Padding="14,7" Margin="0,0,7,0" />
        <Button Content="始终允许" Command="{Binding AlwaysApproveCommand}" FontSize="11" FontWeight="SemiBold" Background="#337CFF9B" Foreground="#E8FFE8" BorderBrush="#667CFF9B" Padding="14,7" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
