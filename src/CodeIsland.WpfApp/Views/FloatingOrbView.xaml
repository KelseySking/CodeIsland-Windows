<UserControl x:Class="CodeIsland.WpfApp.Views.FloatingOrbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Width="48"
             Height="48"
             Background="Transparent"
             ClipToBounds="False">
  <!-- 48 transparent canvas: 36 icon + room for top-right badge. No drop shadow. -->
  <Grid Width="48" Height="48" Cursor="Hand" Background="Transparent" ClipToBounds="False">
    <!-- Icon + pending ring share one cell so the ring stays concentric. -->
    <Grid Width="36"
          Height="36"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          Margin="4,0,0,4"
          ClipToBounds="False">
      <Border x:Name="PendingGlow"
              Margin="-2"
              CornerRadius="12"
              BorderBrush="#FFFFB86B"
              BorderThickness="2"
              Background="Transparent"
              Opacity="0"
              IsHitTestVisible="False"
              Visibility="{Binding HasPendingAction, Converter={x:Static views:BoolVisibilityConverter.Instance}}" />

      <Border CornerRadius="10"
              Background="#FF1B2433"
              BorderBrush="#18000000"
              BorderThickness="1">
        <views:PixelMascotControl Width="32"
                                  Height="32"
                                  PixelSize="2.15"
                                  SessionSource="{Binding ActiveSource}"
                                  SessionStatus="{Binding ActiveStatus}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
      </Border>
    </Grid>

    <!-- Session count: fully inside canvas, not clipped -->
    <Border MinWidth="16"
            Height="16"
            Padding="4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,2,2,0"
            CornerRadius="8"
            Background="#FFF0A12B"
            Visibility="{Binding HasSessions, Converter={x:Static views:BoolVisibilityConverter.Instance}}">
      <TextBlock Text="{Binding ActiveSessionCount}"
                 FontSize="10"
                 FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>

    <Border MinWidth="16"
            Height="16"
            Padding="4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,2,2,0"
            CornerRadius="8"
            Background="#FFFF8A3D"
            Visibility="{Binding HasPendingAction, Converter={x:Static views:BoolVisibilityConverter.Instance}}">
      <TextBlock Text="!"
                 FontSize="10"
                 FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
