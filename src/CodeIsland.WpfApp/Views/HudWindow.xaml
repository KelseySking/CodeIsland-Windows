<Window x:Class="CodeIsland.WpfApp.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="Shell"
          Background="{StaticResource HudBackgroundBrush}"
          BorderBrush="{StaticResource HudBorderBrush}"
          BorderThickness="1"
          CornerRadius="18"
          Padding="9"
          RenderTransformOrigin="0.5,0">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="ShellTranslate" X="0" Y="0" />
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ContentControl x:Name="PendingHost" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <ContentControl x:Name="SurfaceHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
  </Border>
</Window>
