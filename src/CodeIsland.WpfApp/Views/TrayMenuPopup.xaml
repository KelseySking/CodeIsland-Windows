<Window x:Class="CodeIsland.WpfApp.Views.TrayMenuPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeIsland Menu"
        Width="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="MenuRoot"
          Background="#F2050507"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          CornerRadius="18"
          Padding="8"
          Margin="4"
          Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <Border Padding="10,8" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="RuntimeDot" Width="8" Height="8" VerticalAlignment="Center" />
          <TextBlock x:Name="RuntimeStatusText"
                     Margin="8,0,0,0"
                     FontSize="12"
                     Foreground="{StaticResource HudMutedTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <Button x:Name="VisibilityItem" Style="{StaticResource TrayMenuItemStyle}" Content="显示 HUD" />
      <Button x:Name="ExpandItem" Style="{StaticResource TrayMenuItemStyle}" Content="展开 HUD" />

      <Border Height="1" Background="#18FFFFFF" Margin="8,6" />

      <Button x:Name="SettingsItem" Style="{StaticResource TrayMenuItemStyle}" Content="设置…" />
      <Button x:Name="AboutItem" Style="{StaticResource TrayMenuItemStyle}" Content="关于与更新…" />

      <Border Height="1" Background="#18FFFFFF" Margin="8,6" />

      <Button x:Name="ExitItem" Style="{StaticResource TrayMenuDangerItemStyle}" Content="退出" />
    </StackPanel>
  </Border>
</Window>
