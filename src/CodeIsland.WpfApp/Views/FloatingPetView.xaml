<UserControl x:Class="CodeIsland.WpfApp.Views.FloatingPetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodeIsland.WpfApp.Views"
             Width="192"
             Height="208"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <views:PetSpriteControl x:Name="Sprite"
                          SessionStatus="{Binding ActiveStatus}"
                          Cursor="Hand" />
</UserControl>
